; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Salvager"
config/description="Cyberpunk mercenary salvage sim for a multi-display hardware simpit. One process, one native window per monitor."
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://autoload/GameState.gd"
DisplayConfig="*res://autoload/DisplayConfig.gd"
WindowManager="*res://autoload/WindowManager.gd"
InputRouter="*res://autoload/InputRouter.gd"

[display]

window/subwindows/embed_subwindows=false

[rendering]

renderer/rendering_method="forward_plus"
